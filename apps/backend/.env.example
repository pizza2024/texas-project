# ============================================
# Backend 环境变量
# ============================================
# 复制此文件为 .env 并填写实际值

NODE_ENV=production
PORT=4000

# 数据库
# 开发环境: postgresql://texas:texas_password@localhost:5432/texas_staging
# 生产环境: postgresql://texas:texas_password@postgres:5432/texas_staging (Docker 内)
DATABASE_URL=postgresql://texas:texas_password@localhost:5432/texas_staging?schema=public

# Redis
# 开发环境: redis://localhost:6379
# 生产环境: redis://redis:6379 (Docker 内)
REDIS_URL=redis://localhost:6379

# JWT 配置
# 生成: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_EXPIRES_IN=7d

# CORS 配置
# 开发环境: http://localhost:3000,http://localhost:3001
# 生产环境: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# 区块链配置 (可选)
# ============================================
# ETH 主网 RPC
ETH_RPC_URL=
# 助记词 (HD 钱包派生充值地址)
HD_WALLET_MNEMONIC=
# USDT 合约地址
USDT_CONTRACT_ADDRESS=
USDT_DECIMALS=6
USDT_TO_CHIPS_RATE=100
DEPOSIT_MIN_CONFIRMATIONS=1
DEPOSIT_POLL_INTERVAL_MS=30000

# ============================================
# 邮件配置 (可选)
# ============================================
RESEND_API_KEY=
SMTP_FROM=noreply@example.com
