# Texas Poker Staging Environment
# 测试服务器: 35.73.94.102

# ============================================
# Domain
# ============================================
DOMAIN=35.73.94.102.nip.io

# ============================================
# Backend
# ============================================
NODE_ENV=staging
PORT=4000
DATABASE_URL=postgresql://texas:texas_password@localhost:5432/texas_staging?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=texas_staging_jwt_secret_change_in_production_$(openssl rand -base64 24)
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://35.73.94.102.nip.io:3000,http://35.73.94.102.nip.io:3001
SOCKET_CORS_ORIGIN=http://35.73.94.102.nip.io:3000,http://35.73.94.102.nip.io:3001
WS_ALLOWED_ORIGINS=http://35.73.94.102.nip.io:3000,http://35.73.94.102.nip.io:3001

# ============================================
# Blockchain (ETH Sepolia)
# ============================================
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
BNB_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Wallet mnemonic (for withdrawals)
HD_WALLET_MNEMONIC=your_metamask_seed_phrase_here

# USDT Contract Addresses
USDT_CONTRACT_ADDRESS=0xYourTestUSDtAddressOnSepolia
BNB_USDT_CONTRACT=0xYourTestUSDtAddressOnBNBTestnet

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_URL=http://35.73.94.102.nip.io:4000
NEXT_PUBLIC_WS_URL=ws://35.73.94.102.nip.io:4000
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_USDT_SYMBOL=USDT
