# ============================================
# Texas Poker - 环境变量配置
# ============================================
# 复制此文件为 .env 并填写实际值
# Docker 基础设施使用此文件

# ============================================
# 域名配置
# ============================================
DOMAIN=example.com

# ============================================
# PostgreSQL 数据库
# ============================================
DB_USER=texas
DB_PASSWORD=texas_password
DB_NAME=texas_staging
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# SSL 证书路径
# ============================================
SSL_CERT_FILE=/etc/nginx/certs/${DOMAIN}.crt
SSL_CERT_KEY=/etc/nginx/certs/${DOMAIN}.key

# ============================================
# 后端配置 (apps/backend)
# ============================================
NODE_ENV=production
PORT=4000

# JWT 配置
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_EXPIRES_IN=7d

# CORS 配置 (开发环境: http://localhost:3000,http://localhost:3001)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# 区块链配置 (可选)
# ============================================
# ETH 主网 RPC
ETH_RPC_URL=
# 助记词 (HD 钱包派生充值地址)
HD_WALLET_MNEMONIC=
# USDT 合约地址
USDT_CONTRACT_ADDRESS=
USDT_DECIMALS=6
USDT_TO_CHIPS_RATE=100
DEPOSIT_MIN_CONFIRMATIONS=1
DEPOSIT_POLL_INTERVAL_MS=30000

# ============================================
# 邮件配置 (可选)
# ============================================
RESEND_API_KEY=
SMTP_FROM=noreply@example.com

# ============================================
# 前端配置 (apps/web & apps/admin)
# ============================================
# API 地址 (开发环境指向本地后端)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://etherscan.io
